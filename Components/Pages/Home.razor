@page "/"
@inject BioStackDbContext DbContext
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using BioStack.Components.Dialogs

<PageTitle>BioStack - Dashboard</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">Dashboard</MudText>

<MudGrid>
    <!-- Health Metrics Summary Card -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="3">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h5">Today's Health Metrics</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="LogMetrics">Log</MudButton>
            </div>
            <MudGrid>
                <MudItem xs="6">
                    <div class="d-flex align-center justify-center relative" style="position: relative; width: 200px; height: 200px;">
                        <MudChart ChartType="ChartType.Donut" Width="200px" Height="200px"
                                  InputData="@_energyData" InputLabels="@_energyLabels" ChartOptions="@_energyChartOptions">
                        </MudChart>
                        <div class="d-flex flex-column align-center justify-center" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="color: #1EC8A5; font-size: 12px;" />
                                <MudText Typo="Typo.h6" Align="Align.Center">Energy</MudText>
                            </div>
                            <MudText Typo="Typo.h5" Align="Align.Center">@(_todayMetrics?.EnergyLevel ?? 0)/10</MudText>
                        </div>
                    </div>
                </MudItem>
                <MudItem xs="6">
                    <div class="d-flex align-center justify-center relative" style="position: relative; width: 200px; height: 200px;">
                        <MudChart ChartType="ChartType.Donut" Width="200px" Height="200px"
                                  InputData="@_sleepData" InputLabels="@_sleepLabels" ChartOptions="@_sleepChartOptions">
                        </MudChart>
                        <div class="d-flex flex-column align-center justify-center" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="color: #2196F3; font-size: 12px;" />
                                <MudText Typo="Typo.h6" Align="Align.Center">Sleep</MudText>
                            </div>
                            <MudText Typo="Typo.h5" Align="Align.Center">@(_todayMetrics?.SleepQuality ?? 0)/10</MudText>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    <!-- Supplement Adherence Card -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Today's Supplements</MudText>
            <MudProgressLinear Color="Color.Success" Value="@_supplementAdherence" Class="my-4">
                <MudText Typo="Typo.body2">@_supplementAdherence.ToString("0")%</MudText>
            </MudProgressLinear>
            <MudGrid Spacing="2">
                @foreach (var intake in _todayIntakes)
                {
                    <MudItem xs="12" sm="6">
                        <div @onclick="@(() => ToggleSupplement(intake))" class="d-flex align-center pa-2 rounded mud-paper" style="cursor: pointer;">
                            @if (intake.Taken)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-3" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.RadioButtonUnchecked" Color="Color.Default" Class="mr-3" />
                            }
                            <div>
                                <MudText Typo="Typo.body1">@intake.Supplement?.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@intake.Supplement?.Dosage</MudText>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </MudItem>

    <!-- Weekly Activity Chart -->
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Weekly Activity</MudText>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@_weeklySeries" XAxisLabels="@_weeklyLabels" Width="100%" Height="300px"></MudChart>
        </MudPaper>
    </MudItem>

    <!-- Recent Workouts -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Recent Workouts</MudText>
            @if (_recentWorkouts.Any())
            {
                <MudList Dense="true">
                    @foreach (var workout in _recentWorkouts)
                    {
                        <MudListItem>
                            <div class="d-flex">
                                <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.body1">@workout.Name</MudText>
                                    <MudText Typo="Typo.caption">@workout.Date.ToString("MMM dd") - @workout.DurationMinutes min</MudText>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText>No recent workouts found.</MudText>
            }
        </MudPaper>
    </MudItem>

    <!-- Quick Actions -->
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="3">
            <MudText Typo="Typo.h5" Class="mb-4">Quick Actions</MudText>
            <MudGrid>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.AddCircle" Href="supplements">Add Supplement</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" StartIcon="@Icons.Material.Filled.FitnessCenter" Href="workouts">Log Workout</MudButton>
                </MudItem>
                <MudItem xs="12" Class="mt-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Insights" Href="reports">View Reports</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private HealthMetric? _todayMetrics;
    private List<IntakeLog> _todayIntakes = new();
    private List<Workout> _recentWorkouts = new();
    private double _supplementAdherence = 0;

    // Chart data
    private double[] _energyData = { 0, 10 };
    private string[] _energyLabels = { "Energy", "" };
    private double[] _sleepData = { 0, 10 };
    private string[] _sleepLabels = { "Sleep", "" };

    private List<ChartSeries> _weeklySeries = new();
    private string[] _weeklyLabels = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private ChartOptions _energyChartOptions = new ChartOptions
    {
        ChartPalette = new[] { "#1EC8A5", "#E0E0E0" }, // Lighter Teal for Energy, Grey for Empty
        DisableLegend = true
    };

    private ChartOptions _sleepChartOptions = new ChartOptions
    {
        ChartPalette = new[] { "#2196F3", "#E0E0E0" }, // Blue for Sleep, Grey for Empty
        DisableLegend = true
    };

    protected override async Task OnInitializedAsync()
    {
        await BackfillLogDates(); // Restore historical data
        await LoadDashboardDataAsync();
    }

    private async Task BackfillLogDates()
    {
        // One-time fix: Find logs with default LogDate (0001-01-01) and set them to IntakeTime.Date
        var logsToFix = await DbContext.IntakeLogs
            .Where(il => il.LogDate == DateTime.MinValue)
            .ToListAsync();

        if (logsToFix.Any())
        {
            foreach (var log in logsToFix)
            {
                log.LogDate = log.IntakeTime.Date;
            }
            DbContext.IntakeLogs.UpdateRange(logsToFix);
            await DbContext.SaveChangesAsync();
            Snackbar.Add($"Restored {logsToFix.Count} historical records.", Severity.Success);
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        var today = DateTime.Today;

        // Get today's health metrics
        _todayMetrics = await DbContext.HealthMetrics
            .OrderByDescending(hm => hm.Date)
            .FirstOrDefaultAsync();

        if (_todayMetrics != null)
        {
            // Update energy chart
            if (_todayMetrics.EnergyLevel.HasValue)
            {
                _energyData = new double[] { _todayMetrics.EnergyLevel.Value, 10 - _todayMetrics.EnergyLevel.Value };
            }

            // Update sleep chart
            if (_todayMetrics.SleepQuality.HasValue)
            {
                _sleepData = new double[] { _todayMetrics.SleepQuality.Value, 10 - _todayMetrics.SleepQuality.Value };
            }
        }

        // Get today's supplement intakes and ensure every active supplement is represented
        var todaysLogs = await DbContext.IntakeLogs
            .Include(il => il.Supplement)
            .Where(il => il.LogDate == today)
            .ToListAsync();

        var activeSupplements = await DbContext.Supplements
            .Where(s => s.IsActive)
            .ToListAsync();

        var logLookup = todaysLogs
            .GroupBy(il => il.SupplementId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(l => l.IntakeTime).First());

        _todayIntakes = activeSupplements
            .Select(supplement =>
            {
                if (logLookup.TryGetValue(supplement.Id, out var log))
                {
                    return log;
                }

                return new IntakeLog
                {
                    SupplementId = supplement.Id,
                    Supplement = supplement,
                    IntakeTime = today,
                    LogDate = today,
                    Taken = false
                };
            })
            .OrderBy(i => i.Supplement?.Name)
            .ToList();

        // Include logs for inactive supplements so historical data still shows up
        _todayIntakes.AddRange(todaysLogs.Where(log => activeSupplements.All(s => s.Id != log.SupplementId)));

        var takenDistinctSupplements = todaysLogs
            .Where(il => il.Taken)
            .Select(il => il.SupplementId)
            .Distinct()
            .Count();

        if (activeSupplements.Any())
        {
            _supplementAdherence = (double)takenDistinctSupplements / activeSupplements.Count * 100;
        }
        else if (todaysLogs.Any())
        {
            var takenLogs = todaysLogs.Count(il => il.Taken);
            _supplementAdherence = (double)takenLogs / todaysLogs.Count * 100;
        }
        else
        {
            _supplementAdherence = 0;
        }

        // Get recent workouts
        _recentWorkouts = await DbContext.Workouts
            .OrderByDescending(w => w.Date)
            .Take(5)
            .ToListAsync();

        // Set up weekly activity chart
        var pastWeek = Enumerable.Range(0, 7)
            .Select(i => today.AddDays(-i))
            .Reverse()
            .ToList();

        var workoutData = new List<double>();
        var supplementData = new List<double>();

        foreach (var date in pastWeek)
        {
            var nextDay = date.AddDays(1);
            
            // Count workouts for this day
            var workoutCount = await DbContext.Workouts
                .CountAsync(w => w.Date >= date && w.Date < nextDay);
            workoutData.Add(workoutCount);

            // Count supplements taken for this day
            var supplementCount = await DbContext.IntakeLogs
                .CountAsync(il => il.LogDate == date && il.Taken);
            supplementData.Add(supplementCount);
        }

        _weeklySeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "Workouts", Data = workoutData.ToArray() },
            new ChartSeries { Name = "Supplements Taken", Data = supplementData.ToArray() }
        };

        _weeklyLabels = pastWeek.Select(d => d.ToString("ddd")).ToArray();
    }

    private async Task LogMetrics()
    {
        var parameters = new DialogParameters
        {
            { nameof(LogMetricsDialog.InitialEnergy), _todayMetrics?.EnergyLevel ?? 5 },
            { nameof(LogMetricsDialog.InitialSleep), _todayMetrics?.SleepQuality ?? 5 }
        };

        var dialog = await DialogService.ShowAsync<LogMetricsDialog>("Log Health Metrics", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is not null)
        {
            // Use reflection or dynamic to get data from anonymous type if needed, 
            // but since we know the structure:
            dynamic data = result.Data;
            int energy = data.Energy;
            int sleep = data.Sleep;

            if (_todayMetrics == null)
            {
                _todayMetrics = new HealthMetric
                {
                    Date = DateTime.Now,
                    EnergyLevel = energy,
                    SleepQuality = sleep,
                    Weight = await DbContext.UserProfiles.Select(p => p.Weight).FirstOrDefaultAsync(),
                    WeightUnit = await DbContext.UserProfiles.Select(p => p.WeightUnit).FirstOrDefaultAsync() ?? "lbs"
                };
                DbContext.HealthMetrics.Add(_todayMetrics);
            }
            else
            {
                _todayMetrics.EnergyLevel = energy;
                _todayMetrics.SleepQuality = sleep;
                DbContext.HealthMetrics.Update(_todayMetrics);
            }

            await DbContext.SaveChangesAsync();
            await LoadDashboardDataAsync(); // Refresh charts
        }
    }

    private async Task ToggleSupplement(IntakeLog log)
    {
        try
        {
            if (log.Id == 0)
            {
                // Create new log object
                var newLog = new IntakeLog
                {
                    SupplementId = log.SupplementId,
                    Taken = true,
                    IntakeTime = DateTime.Now,
                    LogDate = DateTime.Today
                };
                DbContext.IntakeLogs.Add(newLog);
            }
            else
            {
                // Update existing log
                // Explicitly fetch the entity to ensure we are modifying the tracked record
                var existingLog = await DbContext.IntakeLogs.FindAsync(log.Id);
                if (existingLog != null)
                {
                    existingLog.Taken = !existingLog.Taken; // Flip the status of the DB record
                    existingLog.IntakeTime = DateTime.Now;
                    existingLog.LogDate = DateTime.Today;
                    DbContext.IntakeLogs.Update(existingLog);
                }
                else 
                {
                    // Fallback (rare race condition or untracked): use the passed log
                    log.Taken = !log.Taken;
                    log.IntakeTime = DateTime.Now;
                    log.LogDate = DateTime.Today;
                    DbContext.IntakeLogs.Update(log);
                }
            }

            await DbContext.SaveChangesAsync();
            await LoadDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving supplement: {ex.Message}", Severity.Error);
            Console.WriteLine(ex);
        }
    }
}
