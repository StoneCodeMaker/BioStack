@inherits LayoutComponentBase

<MudThemeProvider Theme="_bioStackTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <div class="biostack-logo ml-3">
            <img src="images/logo.svg" alt="BioStack Logo" width="32" height="32" class="biostack-logo-icon" />
            <MudText Typo="Typo.h5">BioStack</MudText>
        </div>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Edge="Edge.End" />
        <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Edge="Edge.End" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader>
            <div class="biostack-logo">
                <img src="images/logo.svg" alt="BioStack Logo" width="24" height="24" class="biostack-logo-icon" />
                <MudText Typo="Typo.h6">BioStack</MudText>
            </div>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
    
    private MudTheme _bioStackTheme = new MudTheme()
    {
        Palette = new PaletteLight()
        {
            Primary = "#009688",
            Secondary = "#37474F",
            AppbarBackground = "#009688",
            Background = "#F5F5F5",
            DrawerBackground = "#FFF",
            DrawerText = "rgba(0,0,0, 0.7)",
            Success = "#4caf50"
        }
    };

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
